          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool_name, state) (npgsql_db_client_connections_usage{pool_name=~\"seatres-.*\"})",
          "legendFormat": "{{pool_name}} {{state}}"
        },
        {
          "refId": "B",
          "expr": "npgsql_db_client_connections_max{pool_name=~\"seatres-.*\"}",
          "legendFormat": "{{pool_name}} max"
        },
        {
          "refId": "C",
          "expr": "npgsql_db_client_connections_pending_requests{pool_name=~\"seatres-.*\"}",
          "legendFormat": "{{pool_name}} pending"
        }
      ],
      "id": 13
    },
