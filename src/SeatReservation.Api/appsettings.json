{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=seatres;Username=seatres;Password=seatres"
  },
  "Database": {
    "MaxPoolSize": 40,
    "OpsPoolSize": 3,
    "ConnectionTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 15,
    "LockTimeoutMs": 10000,
    "StartupRetrySeconds": 120
  },
  "Auth": {
    "Issuer": "seat-reservation",
    "Audience": "seat-reservation-api",
    "TokenLifetimeHours": 12
  },
  "Reservations": {
    "DefaultPerUserLimit": 4,
    "MaxSeatsPerRequest": 20
  },
  "Shows": {
    "RequireAuth": false,
    "MaxSeats": 10000
  },
  "Admission": {
    "QueueLimit": 50000
  },
  "Metrics": {
    "SeatGaugeCacheSeconds": 1,
    "MaxShowsInGauges": 200
  },
  "Shutdown": {
    "DrainSeconds": 5
  }
}
